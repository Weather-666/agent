# Base URL used by the browser-side axios client (lib/request.ts).
# Exposed to the browser via the NEXT_PUBLIC_ prefix.
# Leave empty to call the same-origin Next.js API routes under /api/v1.
NEXT_PUBLIC_API_BASE_URL=

# Real backend service URL that Next.js API routes proxy requests to.
# Server-only (no NEXT_PUBLIC_ prefix), never exposed to the browser.
# Required: the proxy layer throws on startup if this is missing.
SERVER_API_BASE_URL=

# Default tenant ID for browser-side requests (sent as the X-Tenant-ID header).
# Exposed to the browser. Only a fallback: the tenant from the JWT token or
# localStorage takes precedence. Defaults to "tenant_default" when unset.
NEXT_PUBLIC_TENANT_ID=

# Default tenant ID for server-side proxy requests.
# Server-only fallback used when the request header/cookie has no tenant.
# Defaults to "tenant_default" when unset.
SERVER_TENANT_ID=
