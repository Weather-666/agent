EXPERT_JWT_SECRET=change-me
EXPERT_PLATFORM_ACTIVATION_TOKEN_TTL_SECONDS=604800
EXPERT_PASSWORD_RESET_CODE_TTL_SECONDS=600
EXPERT_PASSWORD_RESET_COOLDOWN_SECONDS=60
EXPERT_PASSWORD_RESET_MAX_ATTEMPTS=5
EXPERT_DEFAULT_TENANT_ID=tenant_default
EXPERT_DATABASE_URL=sqlite:///./data/experts-backend.sqlite3
EXPERT_DATABASE_AUTO_MIGRATE=true
EXPERT_DATABASE_SCHEMA_DIR=./infra/sql

# Estimated cache-aware credit calculator. Values are read at Backend process startup.
EXPERT_CREDIT_TOKENS_PER_CREDIT=500
EXPERT_CREDIT_CACHED_INPUT_WEIGHT=0.1

# SMTP delivery for password-reset verification codes.
EXPERT_SMTP_SERVER=smtp.example.com
EXPERT_SMTP_PORT=465
EXPERT_SMTP_USERNAME=
EXPERT_SMTP_PASSWORD=
EXPERT_SMTP_FROM_ADDRESS=no-reply@example.com
EXPERT_SMTP_FROM_NAME=WinWise
EXPERT_SMTP_USE_SSL=true
EXPERT_SMTP_TIMEOUT_SECONDS=10

# agent-gateway ACP data plane. The route prefix is the gateway's external path prefix for the
# ACP route; the client posts to <prefix>/turn and <prefix>/permission, and reads history from
# <prefix>/sessions and <prefix>/sessions/{id}/transcript (all route-scoped, authenticated by
# ACP_AUTH_TOKEN).
EXPERT_ACP_GATEWAY_BASE_URL=http://127.0.0.1:8080
EXPERT_ACP_ROUTE_PREFIX=
EXPERT_ACP_AUTH_TOKEN=
EXPERT_ACP_CLIENT_ID=experts-backend
EXPERT_ACP_DEFAULT_MODEL=
# Legacy/unbound Chat Sessions only (chat_sessions.expert_id is null). Keep this aligned with the
# existing default ACP Service cwd when an explicit override is required. Empty means omit cwd
# from ACP requests and let the default Gateway Service decide.
EXPERT_ACP_DEFAULT_CWD=
# Bound Expert Chat Sessions only (chat_sessions.expert_id is not null). Required for bound
# sessions. Backend creates this absolute root plus <base>/<tenant_id>; Gateway must see the same
# filesystem path.
EXPERT_ACP_CWD_BASE=/absolute/path/to/tenant-workspaces

# Expert publication. Backend owns fixed Runtime configuration directories, calls Builder through
# this executable with argv (never a shell), and manages Gateway Service/Route/VirtualKey state.
EXPERT_ACP_CONFIG_BASE=/absolute/path/to/experts
EXPERT_BUILDER_EXECUTABLE=/absolute/path/to/experts-builder
EXPERT_ACP_GATEWAY_ADMIN_URL=http://127.0.0.1:8019
EXPERT_ACP_GATEWAY_ADMIN_TOKEN=
EXPERT_RUNTIME_OPERATION_TIMEOUT_SECONDS=120
# The Backend defaults to its bundled sandbox adapter. Override only when the Backend source tree
# is not visible to Gateway. The real global adapter remains an explicit deployment dependency.
# EXPERT_ACP_CODEX_ADAPTER_COMMAND=/absolute/path/to/backend/runtime/codex-acp
EXPERT_ACP_CODEX_REAL_ADAPTER_COMMAND=/usr/local/bin/codex-acp
# Must name the existing VirtualKey whose persistent key is EXPERT_ACP_AUTH_TOKEN. Publication
# updates only its Route allowlist; Backend does not create or rotate this credential.
EXPERT_ACP_VIRTUAL_KEY_ID=backend-acp
# Internal read-only knowledge MCP endpoint reachable by Expert Runtime processes.
EXPERT_KNOWLEDGE_MCP_BASE_URL=http://127.0.0.1:15000/internal/mcp/knowledge

# Both Codex and OpenCode use the Agent Gateway model data plane. This optional API key is a local
# model Route key, not an upstream Provider Credential.
EXPERT_AGENT_GATEWAY_MODEL_BASE_URL=http://127.0.0.1:8080/v1
EXPERT_AGENT_GATEWAY_MODEL_API_KEY=

# Object storage for documents, library files and skill packages. Local is the default for
# development and single-node deployments. Set this to minio for production.
EXPERT_OBJECT_STORAGE_BACKEND=local
EXPERT_OBJECT_STORAGE_LOCAL_DIR=./.data/objects
EXPERT_OBJECT_STORAGE_MAX_UPLOAD_BYTES=104857600
# Account avatars use a separate server-side upload and image-processing policy.
EXPERT_AVATAR_MAX_UPLOAD_BYTES=2097152
EXPERT_AVATAR_MAX_PIXELS=20000000
EXPERT_AVATAR_MAX_DIMENSION=512
EXPERT_AVATAR_URL_TTL_SECONDS=900
# Optional public API origin used when OBJECT_STORAGE_BACKEND=local. Leave empty for same-origin
# relative URLs such as /api/v1/storage/objects/<token>.
EXPERT_OBJECT_STORAGE_PUBLIC_BASE_URL=
EXPERT_LIBRARY_DELIVERY_PUBLIC_BASE_URL=http://localhost:15000

# MinIO object storage, used when OBJECT_STORAGE_BACKEND=minio.
EXPERT_MINIO_ENDPOINT=127.0.0.1:9000
EXPERT_MINIO_ACCESS_KEY=minioadmin
EXPERT_MINIO_SECRET_KEY=minioadmin
EXPERT_MINIO_BUCKET=expert-files
EXPERT_MINIO_SECURE=false

# LightRAG instance lifecycle client. Deploy Controller from lightrag-builder;
# Backend calls its authenticated ensure/health/delete/reconcile API over HTTP.
EXPERT_LIGHTRAG_CONTROLLER_URL=http://127.0.0.1:9630
EXPERT_LIGHTRAG_CONTROLLER_TOKEN=change-me-controller-token
EXPERT_LIGHTRAG_CONTROLLER_TIMEOUT_SECONDS=180

# LightRAG document indexing and query client.
EXPERT_LIGHTRAG_API_KEY=change-me-strong-key
EXPERT_LIGHTRAG_TIMEOUT_SECONDS=40
EXPERT_LIGHTRAG_INSERT_TIMEOUT_SECONDS=60
EXPERT_LIGHTRAG_DELETE_TIMEOUT_SECONDS=180
EXPERT_LIGHTRAG_POLL_INITIAL_SECONDS=2
EXPERT_LIGHTRAG_POLL_MAX_SECONDS=10
EXPERT_LIGHTRAG_QUERY_MODE=hybrid
EXPERT_LIGHTRAG_QUERY_TOP_K=10
EXPERT_LIGHTRAG_QUERY_CHUNK_TOP_K=8
EXPERT_LIGHTRAG_QUERY_ENABLE_RERANK=false
EXPERT_LIGHTRAG_CHUNK_TOKEN_SIZE=800
EXPERT_LIGHTRAG_CHUNK_OVERLAP_TOKEN_SIZE=100

# External Docling service (docling-serve). The automatic sync worker sends original bytes here
# and receives markdown for LightRAG ingestion.
EXPERT_DOCLING_BASE_URL=http://127.0.0.1:5001
EXPERT_DOCLING_TIMEOUT_SECONDS=600
EXPERT_DOCLING_DO_OCR=true
EXPERT_DOCLING_FORCE_OCR=false
EXPERT_DOCLING_OCR_LANGUAGES=[]
EXPERT_DOCLING_PAGE_BREAK_PLACEHOLDER=<!-- expert-source-page-break -->
EXPERT_DOCLING_MAX_CONCURRENCY=1

# Automatic index worker loop.
EXPERT_KNOWLEDGE_INDEX_WORKER_POLL_SECONDS=3
EXPERT_KNOWLEDGE_INDEX_MAX_ATTEMPTS=5
EXPERT_KNOWLEDGE_INDEX_RECONCILE_BATCH_SIZE=100
EXPERT_KNOWLEDGE_INDEX_RETRY_BASE_SECONDS=5
EXPERT_KNOWLEDGE_INDEX_RETRY_MAX_SECONDS=300
EXPERT_KNOWLEDGE_INDEX_PIPELINE_VERSION=docling-page-ocr-locator-v3
EXPERT_KNOWLEDGE_INDEX_WORKER_CONCURRENCY=3
